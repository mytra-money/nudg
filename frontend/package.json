{
  "name": "nudg-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4178",
    "build": "vue-tsc -b && VITE_ROUTER_BASE=/nudg vite build --mode frappe",
    "build:frappe": "vue-tsc -b && VITE_ROUTER_BASE=/nudg vite build --mode frappe",
    "build:standalone": "vue-tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 4178"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "frappe-ui": "^1.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
